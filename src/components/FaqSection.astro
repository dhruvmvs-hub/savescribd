---
// FaqSection.astro - High-intent SEO FAQs with Schema.org FAQPage structured data & dark mode optimizations
const faqs = [
  {
    q: "How to download Scribd documents for free without an account?",
    a: "You can download any public Scribd document for free using SaveScribd without creating an account or providing credit card details. Simply copy the document URL from Scribd, paste it into our input box above, and click 'Download'. SaveScribd connects directly to the document stream and generates a high-resolution PDF or text file in seconds.",
  },
  {
    q: "How can I save a Scribd book or document as a PDF?",
    a: "To save a Scribd book as a PDF, copy the book or document link from Scribd and paste it into SaveScribd. Our engine decrypts the original vector stream, embedded typography, and graphics, compiling them into a complete, printable vector PDF that you can save permanently to your phone, tablet, or computer.",
  },
  {
    q: "Can I download Scribd presentations in PPT format?",
    a: "Yes. SaveScribd is one of the only free tools with dedicated support for downloading Scribd documents and slide decks in PPT format. When you input a presentation URL, you can choose the PPT format export to download slides ready for Microsoft PowerPoint, Google Slides, or Apple Keynote.",
  },
  {
    q: "What makes SaveScribd the top-rated Scribd downloader on Reddit?",
    a: "On Reddit communities like r/Piracy, r/StudentHacks, and r/InternetIsBeautiful, SaveScribd is frequently recommended because it contains zero pop-up advertisements, requires no surveys or software downloads, preserves original vector print quality, and automatically purges temporary server caches every 60 minutes for complete user anonymity.",
  },
  {
    q: "How does the 'Save' browser URL shortcut trick work?",
    a: "Whenever you are viewing a blurred or locked document on Scribd (e.g., https://www.scribd.com/document/12345/Title), simply go to your browser address bar, change 'scribd' to 'savescribd' (making it https://www.savescribd.com/document/12345/Title), and hit Enter. The document will load directly into SaveScribd for immediate conversion.",
  },
  {
    q: "Is using an online Scribd downloader safe and virus-free?",
    a: "Yes, SaveScribd is 100% safe. Because it is an online web tool, you never need to install executable files, browser plugins, or suspect software. Every file compiled by our cloud parser is sandboxed and verified free of scripts, macros, and malware before being served.",
  },
  {
    q: "Can I read unblurred Scribd documents online without downloading them?",
    a: "Yes. SaveScribd features an interactive In-Browser Live Reader. You can view all pages, zoom in and out, navigate across chapters, and read the entire unblurred document directly in your browser on desktop or mobile without saving files to your hard drive.",
  },
  {
    q: "Does this free Scribd downloader work on mobile devices (iPhone & Android)?",
    a: "Yes. SaveScribd is fully optimized for mobile browsers, including Safari on iOS and Chrome on Android. You can paste URLs, view documents in our mobile reader, or save PDFs directly to your phone's Files or Downloads folder.",
  },
  {
    q: "What formats can I export from Scribd?",
    a: "SaveScribd supports 4 output formats: High-Definition Vector PDF (for printing and reading), PPT Format (for presentations and slide decks), Clean Extracted Text (.txt for AI summarization and research notes), and Microsoft Word (.docx).",
  },
  {
    q: "Why did a document return an 'Unable to Access' or conversion error?",
    a: "Documents will fail to convert if they are marked strictly private by the author, have been removed from Scribd's servers, or are audiobook audio streams. SaveScribd is designed for text publications, books, research papers, and slide presentations.",
  },
];
---

<section id="faq" class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16 scroll-mt-24">
  <div class="text-center mb-10 sm:mb-12">
    <div class="inline-block px-2.5 py-0.5 rounded text-[11px] font-mono uppercase tracking-wide text-[#171717] dark:text-[#ededed] bg-[#fafafa] dark:bg-[#111111] border border-[#ebebeb] dark:border-[#262626] mb-3">
      FREQUENTLY ASKED QUESTIONS
    </div>
    <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717] dark:text-[#ededed] text-balance">
      Everything You Need to Know About Downloading Scribd Documents
    </h2>
    <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] max-w-xl mx-auto mt-2 text-balance leading-relaxed">
      Common queries answered for students, researchers, and professionals using our free online scribd downloader.
    </p>
  </div>

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details class="group rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#111111] p-5 sm:p-6 transition-all open:border-[#171717] dark:open:border-[#ededed] shadow-2xs">
          <summary class="flex items-center justify-between font-semibold text-xs sm:text-sm md:text-base text-[#171717] dark:text-[#ededed] cursor-pointer list-none select-none">
            <span class="pr-3 sm:pr-4">{faq.q}</span>
            <span class="w-6 h-6 rounded-md bg-[#fafafa] dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#262626] flex items-center justify-center text-xs font-mono text-[#888888] dark:text-[#757575] group-open:rotate-180 transition-transform shrink-0">
              ↓
            </span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed pt-3 border-t border-[#ebebeb] dark:border-[#262626]">
            {faq.a}
          </p>
        </details>
      ))
    }
  </div>

  <!-- FAQPage Schema for Google Rich Search Snippets -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.a
      }
    }))
  })} />
</section>
