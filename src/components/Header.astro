---
// Header.astro - Built strictly according to fontfinderai.com aesthetic & dark mode tokens
import { locales, localeNames, type Locale } from "../i18n/locales";
const currentPath = Astro.url.pathname;
const locale = (Astro.props.locale ?? 'en') as Locale;
---

<header class="sticky top-0 z-50 w-full border-b border-[#ebebeb] dark:border-[#262626] bg-white/85 dark:bg-[#0a0a0a]/85 backdrop-blur-md transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group shrink-0" aria-label="SaveScribd Home">
      <div class="w-8 h-8 rounded-lg bg-[#171717] dark:bg-[#ededed] flex items-center justify-center text-white dark:text-[#0a0a0a] font-mono font-bold text-sm shadow-xs group-hover:scale-105 transition-all">
        S
      </div>
      <div class="flex items-baseline gap-1.5">
        <span class="font-semibold text-lg tracking-tight text-[#171717] dark:text-[#ededed]">savescribd</span>
        <span class="text-xs font-mono font-medium text-[#888888] dark:text-[#757575] bg-[#fafafa] dark:bg-[#111111] px-1.5 py-0.5 rounded border border-[#ebebeb] dark:border-[#262626]">v2.0</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-1.5 text-xs lg:text-sm font-medium text-[#4d4d4d] dark:text-[#a1a1a1]">
      <a
        href="/"
        class={`px-3 py-1.5 rounded-full transition-colors ${
          currentPath === "/"
            ? "text-[#171717] dark:text-[#ededed] bg-[#f5f5f5] dark:bg-[#1a1a1a] font-semibold"
            : "hover:text-[#171717] dark:hover:text-[#ededed] hover:bg-[#fafafa] dark:hover:bg-[#111111]"
        }`}
      >
        Home
      </a>
      <a
        href="/blog"
        class={`px-3 py-1.5 rounded-full transition-colors ${
          currentPath === "/blog"
            ? "text-[#171717] dark:text-[#ededed] bg-[#f5f5f5] dark:bg-[#1a1a1a] font-semibold"
            : "hover:text-[#171717] dark:hover:text-[#ededed] hover:bg-[#fafafa] dark:hover:bg-[#111111]"
        }`}
      >
        Blog
      </a>
      <a
        href="/privacy"
        class={`px-3 py-1.5 rounded-full transition-colors ${
          currentPath === "/privacy"
            ? "text-[#171717] dark:text-[#ededed] bg-[#f5f5f5] dark:bg-[#1a1a1a] font-semibold"
            : "hover:text-[#171717] dark:hover:text-[#ededed] hover:bg-[#fafafa] dark:hover:bg-[#111111]"
        }`}
      >
        Privacy Policy
      </a>
      <a
        href="/terms"
        class={`px-3 py-1.5 rounded-full transition-colors ${
          currentPath === "/terms"
            ? "text-[#171717] dark:text-[#ededed] bg-[#f5f5f5] dark:bg-[#1a1a1a] font-semibold"
            : "hover:text-[#171717] dark:hover:text-[#ededed] hover:bg-[#fafafa] dark:hover:bg-[#111111]"
        }`}
      >
        Terms of Service
      </a>
      <a
        href="/about"
        class={`px-3 py-1.5 rounded-full transition-colors ${
          currentPath === "/about"
            ? "text-[#171717] dark:text-[#ededed] bg-[#f5f5f5] dark:bg-[#1a1a1a] font-semibold"
            : "hover:text-[#171717] dark:hover:text-[#ededed] hover:bg-[#fafafa] dark:hover:bg-[#111111]"
        }`}
      >
        About Us
      </a>
      <a
        href="/contact"
        class={`px-3 py-1.5 rounded-full transition-colors ${
          currentPath === "/contact"
            ? "text-[#171717] dark:text-[#ededed] bg-[#f5f5f5] dark:bg-[#1a1a1a] font-semibold"
            : "hover:text-[#171717] dark:hover:text-[#ededed] hover:bg-[#fafafa] dark:hover:bg-[#111111]"
        }`}
      >
        Contact Us
      </a>
    </nav>

    <!-- Right Header Controls: Dark Mode Switch + Languages Dropdown + Mobile Menu Button -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      <!-- Dark Mode Switch Button -->
      <button
        id="theme-toggle-btn"
        type="button"
        class="w-9 h-9 rounded-full border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#111111] text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-[#ededed] hover:bg-[#fafafa] dark:hover:bg-[#1a1a1a] flex items-center justify-center transition-all cursor-pointer shadow-2xs select-none"
        aria-label="Toggle dark mode"
        title="Toggle dark mode"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg id="theme-sun-icon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4" stroke-width="1.8" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg id="theme-moon-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
      </button>

      <!-- Languages Dropdown -->
      <div class="relative" id="lang-dropdown-container">
        <button
          id="lang-menu-btn"
          type="button"
          aria-expanded="false"
          aria-haspopup="true"
          class="inline-flex items-center gap-1.5 h-9 px-3 rounded-full border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#111111] text-xs lg:text-sm font-medium text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-[#ededed] hover:bg-[#fafafa] dark:hover:bg-[#1a1a1a] transition-all shadow-2xs cursor-pointer select-none"
        >
          <svg class="w-3.5 h-3.5 text-[#888888] dark:text-[#757575]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" stroke-width="1.8" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20M2 12h20" />
          </svg>
          <span class="hidden sm:inline">{localeNames[locale]}</span>
          <span class="sm:hidden font-mono text-xs">{locale.toUpperCase()}</span>
          <svg id="lang-arrow" class="w-3 h-3 text-[#888888] dark:text-[#757575] transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="lang-dropdown-menu"
          class="hidden absolute right-0 mt-2 w-48 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#111111] p-1.5 shadow-xl shadow-black/10 z-50 text-xs font-medium text-[#4d4d4d] dark:text-[#ededed]"
        >
          <div class="px-2.5 py-1.5 text-[10px] font-mono uppercase tracking-wider text-[#888888] dark:text-[#757575] border-b border-[#ebebeb] dark:border-[#262626] mb-1">
            Languages
          </div>
          {locales.map((code) => <a href={code === 'en' ? '/' : `/${code}/`} lang={code} hreflang={code} aria-current={locale === code ? 'page' : undefined} class={`lang-opt w-full flex items-center px-2.5 py-2 rounded-lg hover:bg-[#fafafa] dark:hover:bg-[#1a1a1a] hover:text-[#171717] dark:hover:text-[#ededed] text-left transition-colors ${locale === code ? 'font-semibold' : ''}`}>
            {localeNames[code]}
          </a>)}
        </div>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden w-9 h-9 rounded-lg border border-transparent hover:border-[#ebebeb] dark:hover:border-[#262626] text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-[#ededed] hover:bg-[#fafafa] dark:hover:bg-[#111111] flex items-center justify-center focus:outline-none transition-colors"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg id="menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Collapsible Menu Panel -->
  <div
    id="mobile-nav-panel"
    class="hidden lg:hidden border-t border-[#ebebeb] dark:border-[#262626] bg-white/98 dark:bg-[#0a0a0a]/98 px-4 py-4 space-y-1.5 shadow-xl backdrop-blur-lg"
  >
    <a
      href="/"
      class={`flex items-center h-11 px-3.5 rounded-xl text-sm font-medium transition-colors ${
        currentPath === "/"
          ? "bg-[#f5f5f5] dark:bg-[#1a1a1a] text-[#171717] dark:text-[#ededed] font-semibold"
          : "text-[#4d4d4d] dark:text-[#a1a1a1] hover:bg-[#fafafa] dark:hover:bg-[#111111] hover:text-[#171717] dark:hover:text-[#ededed]"
      }`}
    >
      Home
    </a>
    <a
      href="/blog"
      class={`flex items-center h-11 px-3.5 rounded-xl text-sm font-medium transition-colors ${
        currentPath === "/blog"
          ? "bg-[#f5f5f5] dark:bg-[#1a1a1a] text-[#171717] dark:text-[#ededed] font-semibold"
          : "text-[#4d4d4d] dark:text-[#a1a1a1] hover:bg-[#fafafa] dark:hover:bg-[#111111] hover:text-[#171717] dark:hover:text-[#ededed]"
      }`}
    >
      Blog
    </a>
    <a
      href="/privacy"
      class={`flex items-center h-11 px-3.5 rounded-xl text-sm font-medium transition-colors ${
        currentPath === "/privacy"
          ? "bg-[#f5f5f5] dark:bg-[#1a1a1a] text-[#171717] dark:text-[#ededed] font-semibold"
          : "text-[#4d4d4d] dark:text-[#a1a1a1] hover:bg-[#fafafa] dark:hover:bg-[#111111] hover:text-[#171717] dark:hover:text-[#ededed]"
      }`}
    >
      Privacy Policy
    </a>
    <a
      href="/terms"
      class={`flex items-center h-11 px-3.5 rounded-xl text-sm font-medium transition-colors ${
        currentPath === "/terms"
          ? "bg-[#f5f5f5] dark:bg-[#1a1a1a] text-[#171717] dark:text-[#ededed] font-semibold"
          : "text-[#4d4d4d] dark:text-[#a1a1a1] hover:bg-[#fafafa] dark:hover:bg-[#111111] hover:text-[#171717] dark:hover:text-[#ededed]"
      }`}
    >
      Terms of Service
    </a>
    <a
      href="/about"
      class={`flex items-center h-11 px-3.5 rounded-xl text-sm font-medium transition-colors ${
        currentPath === "/about"
          ? "bg-[#f5f5f5] dark:bg-[#1a1a1a] text-[#171717] dark:text-[#ededed] font-semibold"
          : "text-[#4d4d4d] dark:text-[#a1a1a1] hover:bg-[#fafafa] dark:hover:bg-[#111111] hover:text-[#171717] dark:hover:text-[#ededed]"
      }`}
    >
      About Us
    </a>
    <a
      href="/contact"
      class={`flex items-center h-11 px-3.5 rounded-xl text-sm font-medium transition-colors ${
        currentPath === "/contact"
          ? "bg-[#f5f5f5] dark:bg-[#1a1a1a] text-[#171717] dark:text-[#ededed] font-semibold"
          : "text-[#4d4d4d] dark:text-[#a1a1a1] hover:bg-[#fafafa] dark:hover:bg-[#111111] hover:text-[#171717] dark:hover:text-[#ededed]"
      }`}
    >
      Contact Us
    </a>

    <!-- Mobile Theme Toggle Option -->
    <div class="pt-2 mt-2 border-t border-[#ebebeb] dark:border-[#262626]">
      <button
        id="mobile-theme-toggle-btn"
        type="button"
        class="w-full flex items-center justify-between h-11 px-3.5 rounded-xl text-sm font-medium text-[#4d4d4d] dark:text-[#a1a1a1] hover:bg-[#fafafa] dark:hover:bg-[#111111] transition-colors"
      >
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 text-[#888888] dark:text-[#757575]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
          </svg>
          <span>Appearance</span>
        </span>
        <span id="mobile-theme-status" class="text-xs font-mono uppercase text-[#888888] dark:text-[#757575]">
          Light
        </span>
      </button>
    </div>
  </div>
</header>

<script>
  function setupHeaderInteractivity() {
    const themeBtn = document.getElementById("theme-toggle-btn");
    const mobileThemeBtn = document.getElementById("mobile-theme-toggle-btn");
    const sunIcon = document.getElementById("theme-sun-icon");
    const moonIcon = document.getElementById("theme-moon-icon");
    const mobileThemeStatus = document.getElementById("mobile-theme-status");

    function updateThemeUI() {
      const isDark = document.documentElement.classList.contains("dark");
      if (isDark) {
        sunIcon?.classList.remove("hidden");
        moonIcon?.classList.add("hidden");
        if (mobileThemeStatus) mobileThemeStatus.textContent = "Dark";
      } else {
        sunIcon?.classList.add("hidden");
        moonIcon?.classList.remove("hidden");
        if (mobileThemeStatus) mobileThemeStatus.textContent = "Light";
      }
    }

    function toggleDarkMode() {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      updateThemeUI();
    }

    if (themeBtn) {
      themeBtn.addEventListener("click", toggleDarkMode);
    }
    if (mobileThemeBtn) {
      mobileThemeBtn.addEventListener("click", toggleDarkMode);
    }
    updateThemeUI();

    const langBtn = document.getElementById("lang-menu-btn");
    const langMenu = document.getElementById("lang-dropdown-menu");
    const langArrow = document.getElementById("lang-arrow");
    const langContainer = document.getElementById("lang-dropdown-container");

    const mobileToggle = document.getElementById("mobile-menu-toggle");
    const mobilePanel = document.getElementById("mobile-nav-panel");
    const menuOpenIcon = document.getElementById("menu-icon-open");
    const menuCloseIcon = document.getElementById("menu-icon-close");

    if (langBtn && langMenu && langArrow) {
      langBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = !langMenu.classList.contains("hidden");
        if (isOpen) {
          langMenu.classList.add("hidden");
          langArrow.classList.remove("rotate-180");
          langBtn.setAttribute("aria-expanded", "false");
        } else {
          langMenu.classList.remove("hidden");
          langArrow.classList.add("rotate-180");
          langBtn.setAttribute("aria-expanded", "true");
        }
      });

      document.addEventListener("click", (e) => {
        if (langContainer && !langContainer.contains(e.target as Node)) {
          langMenu.classList.add("hidden");
          langArrow.classList.remove("rotate-180");
          langBtn.setAttribute("aria-expanded", "false");
        }
      });
    }

    if (mobileToggle && mobilePanel && menuOpenIcon && menuCloseIcon) {
      mobileToggle.addEventListener("click", () => {
        const isClosed = mobilePanel.classList.contains("hidden");
        if (isClosed) {
          mobilePanel.classList.remove("hidden");
          menuOpenIcon.classList.add("hidden");
          menuCloseIcon.classList.remove("hidden");
          mobileToggle.setAttribute("aria-expanded", "true");
        } else {
          mobilePanel.classList.add("hidden");
          menuOpenIcon.classList.remove("hidden");
          menuCloseIcon.classList.add("hidden");
          mobileToggle.setAttribute("aria-expanded", "false");
        }
      });
    }
  }

  setupHeaderInteractivity();
  document.addEventListener("astro:page-load", setupHeaderInteractivity);
</script>
