---
// PrefixTrickBanner.astro - Explaining the "Save" shortcut hack with fontfinder tokens
---

<div id="shortcut" class="max-w-4xl mx-auto px-4 sm:px-6 pt-10 sm:pt-14 pb-6">
  <div class="rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#111111] p-5 sm:p-6 shadow-2xs transition-colors">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="space-y-1.5 min-w-0">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono font-semibold bg-blue-50 dark:bg-blue-950/60 text-[#0070f3] dark:text-blue-400 border border-blue-200/80 dark:border-blue-900/60">
            PRO TIP
          </span>
          <h2 class="text-sm sm:text-base md:text-lg font-semibold text-[#171717] dark:text-[#ededed]">The "Save" Address Bar Shortcut</h2>
        </div>
        <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          Browsing a locked document on Scribd? Change <code class="bg-white dark:bg-[#1a1a1a] text-[#171717] dark:text-[#ededed] px-1.5 py-0.5 rounded font-mono text-xs border border-[#ebebeb] dark:border-[#262626]">scribd.com</code> to <code class="bg-white dark:bg-[#1a1a1a] text-[#0070f3] dark:text-blue-400 font-semibold px-1.5 py-0.5 rounded font-mono text-xs border border-[#ebebeb] dark:border-[#262626]">savescribd.com</code> in your browser URL bar!
        </p>
      </div>

      <!-- Copyable Demo URL -->
      <div class="w-full md:w-auto bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#262626] rounded-xl p-2 sm:p-2.5 flex items-center justify-between gap-2.5 sm:gap-3 text-xs font-mono shrink-0 transition-colors">
        <div class="truncate flex-1 min-w-0 max-w-full sm:max-w-[320px]">
          <span class="text-[#888888] dark:text-[#757575]">https://www.</span><span class="text-[#0070f3] font-semibold underline decoration-2">savescribd</span><span class="text-[#171717] dark:text-[#ededed]">.com/document/59384...</span>
        </div>
        <button
          type="button"
          id="copy-trick-btn"
          class="h-8 px-3 rounded-lg bg-[#fafafa] dark:bg-[#111111] hover:bg-[#f5f5f5] dark:hover:bg-[#262626] text-[#171717] dark:text-[#ededed] border border-[#ebebeb] dark:border-[#262626] transition-colors shrink-0 font-sans text-xs font-medium cursor-pointer active:scale-95 select-none"
        >
          Copy Tip
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function setupCopyTip() {
    const copyBtn = document.getElementById("copy-trick-btn");
    if (copyBtn) {
      copyBtn.addEventListener("click", () => {
        navigator.clipboard.writeText("https://www.savescribd.com/document/593847291/Sample");
        copyBtn.innerText = "Copied!";
        setTimeout(() => {
          copyBtn.innerText = "Copy Tip";
        }, 2000);
      });
    }
  }

  setupCopyTip();
  document.addEventListener("astro:page-load", setupCopyTip);
</script>
