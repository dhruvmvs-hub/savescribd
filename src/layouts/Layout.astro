---
import "../styles/global.css";
import { locales, type Locale } from "../i18n/locales";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  locale?: Locale;
  languageAlternates?: boolean;
}

const {
  title = "Scribd Downloader - Free Online Scribd Downloader PDF & PPT | SaveScribd",
  description = "Use SaveScribd, the #1 free online scribd downloader. Download scribd documents & books as PDF, PPT format, TXT or DOCX instantly without an account. Fast, safe & rated best on Reddit.",
  keywords = "scribd downloader, scribd downloader ppt format, scribd downloader online, scribd downloader free, scribd downloader pdf, free scribd downloader, scribd downloader ppt free, scribd downloader online free, online scribd downloader, scribd downloader reddit, scribd downloader free online, save scribd, save scribd book as pdf, save scribd free",
  image = "https://savescribd.com/og-image.png",
  locale = "en",
  languageAlternates = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://savescribd.com");
---

<!doctype html>
<html lang={locale} class="scroll-smooth antialiased bg-white dark:bg-[#0a0a0a] text-[#171717] dark:text-[#ededed]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {languageAlternates && locales.map((language) => <link rel="alternate" hreflang={language} href={`https://savescribd.com${language === 'en' ? '/' : `/${language}/`}`} />)}
    {languageAlternates && <link rel="alternate" hreflang="x-default" href="https://savescribd.com/" />}
    <meta name="generator" content={Astro.generator} />

    <!-- Anti-FOUC Dark Mode Initializer -->
    <script is:inline>
      (function () {
        const theme = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (theme === "dark" || (!theme && prefersDark)) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="SaveScribd" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph / Facebook Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SaveScribd" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:secure_url" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SaveScribd - Free Online Scribd Downloader" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@savescribd" />
    <meta name="twitter:creator" content="@savescribd" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content="SaveScribd - Free Online Scribd Downloader" />

    <!-- Geist & Geist Mono Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Comprehensive Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebApplication",
          "@id": "https://savescribd.com/#webapp",
          "name": "SaveScribd - Free Online Scribd Downloader",
          "alternateName": [
            "Scribd Downloader",
            "Free Scribd Downloader",
            "Online Scribd Downloader",
            "Scribd Downloader PDF",
            "Scribd Downloader PPT Format"
          ],
          "url": "https://savescribd.com",
          "applicationCategory": "UtilitiesApplication",
          "operatingSystem": "All (Windows, macOS, iOS, Android, Linux)",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD",
            "availability": "https://schema.org/InStock"
          },
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "4.9",
            "reviewCount": "18420",
            "bestRating": "5",
            "worstRating": "1"
          },
          "description": "The best free online scribd downloader. Convert and save scribd documents, books, and presentations to high-resolution PDF, PPT, TXT, or DOCX instantly.",
          "featureList": [
            "Scribd Downloader PDF Export",
            "Scribd Downloader PPT Format Converter",
            "Free Online Scribd Downloader",
            "Save Scribd Book as PDF",
            "Save Scribd Free with Zero Accounts or Subscriptions",
            "In-Browser Live Document Reader"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://savescribd.com/#website",
          "url": "https://savescribd.com",
          "name": "SaveScribd",
          "description": "Free Online Scribd Downloader for PDF & PPT Format",
          "potentialAction": {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              "urlTemplate": "https://savescribd.com/?url={search_term_string}"
            },
            "query-input": "required name=search_term_string"
          }
        },
        {
          "@type": "Organization",
          "@id": "https://savescribd.com/#organization",
          "name": "SaveScribd",
          "url": "https://savescribd.com",
          "logo": "https://savescribd.com/favicon.svg"
        }
      ]
    })} />
  </head>
  <body class="min-h-screen flex flex-col font-sans selection:bg-[#171717] selection:text-[#ffffff] dark:selection:bg-[#ededed] dark:selection:text-[#09090b] bg-white dark:bg-[#09090b] text-[#171717] dark:text-[#ededed] relative">
    <slot />
  </body>
</html>
